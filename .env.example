# Port d'ecoute. Expose uniquement sur 127.0.0.1 par docker-compose.
PORT=8480

# Identifiant du premier compte administrateur, cree au tout premier demarrage.
# Son mot de passe est genere aleatoirement et affiche UNE SEULE FOIS dans les logs.
ADMIN_LOGIN=admin

# A NE POSER QU'EN DEVELOPPEMENT, sur http://localhost.
# Sans HTTPS, un cookie « __Host- » est rejete par le navigateur : cette variable fait
# tomber le prefixe et l'attribut Secure. En production, ne pas la definir.
# COOKIE_NON_SECURISE=1

# Chemins imposes (facultatif) : par defaut ./data en developpement, /app/data en conteneur.
# MANGALOO_DB_PATH=
# CACHE_DB_PATH=

# Aucune cle de tracker ni de debrideur ici : elles appartiennent a chaque utilisateur,
# se saisissent dans la page Compte, et sont chiffrees avec une cle derivee de son mot
# de passe. L'operateur n'en detient aucune.
